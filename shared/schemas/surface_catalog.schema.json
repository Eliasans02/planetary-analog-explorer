{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetary-analog-explorer.local/schemas/surface_catalog.schema.json",
  "title": "Unranked native relief catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "sources",
    "surfaces"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/assets/[a-zA-Z0-9_./-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "product",
        "product_url",
        "access_url",
        "retrieved_at",
        "license",
        "local_path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "product_url": {
          "type": "string",
          "minLength": 1
        },
        "access_url": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "local_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "body",
        "description",
        "coordinates",
        "source_ids",
        "grid",
        "stats",
        "roi",
        "limitations",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "enum": [
            "moon",
            "earth",
            "mars"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latitude_deg",
            "longitude_deg",
            "frame",
            "provenance"
          ],
          "properties": {
            "latitude_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude_deg": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "frame": {
              "enum": [
                "MOON_ME_DE421",
                "NAD83",
                "MARS_HIRISE_PLANETOCENTRIC"
              ]
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "spacing_m",
            "display_frame",
            "horizontal_method",
            "heights",
            "valid_mask",
            "vertical_zero_m",
            "vertical_datum",
            "vertical_datum_status",
            "native_crs_wkt",
            "native_origin",
            "native_spacing",
            "native_units"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 2,
              "maximum": 257
            },
            "height": {
              "type": "integer",
              "minimum": 2,
              "maximum": 257
            },
            "spacing_m": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "display_frame": {
              "const": "native_projected_relief"
            },
            "horizontal_method": {
              "type": "string",
              "minLength": 1
            },
            "heights": {
              "$ref": "#/$defs/asset"
            },
            "valid_mask": {
              "$ref": "#/$defs/asset"
            },
            "vertical_zero_m": {
              "type": "number"
            },
            "vertical_datum": {
              "type": [
                "string",
                "null"
              ]
            },
            "vertical_datum_status": {
              "enum": [
                "unverified",
                "source_declared"
              ]
            },
            "native_crs_wkt": {
              "type": "string",
              "minLength": 1
            },
            "native_origin": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "native_spacing": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "native_units": {
              "enum": [
                "m",
                "deg"
              ]
            }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_source_height_m",
            "max_source_height_m",
            "relief_m",
            "valid_samples",
            "total_samples",
            "direct_return_samples"
          ],
          "properties": {
            "min_source_height_m": {
              "type": "number"
            },
            "max_source_height_m": {
              "type": "number"
            },
            "relief_m": {
              "type": "number",
              "minimum": 0
            },
            "valid_samples": {
              "type": "integer",
              "minimum": 0
            },
            "total_samples": {
              "type": "integer",
              "minimum": 0
            },
            "direct_return_samples": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "roi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "kind",
            "outline_grid",
            "source_record"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "published_source_polygon",
                "project_selected_window"
              ]
            },
            "outline_grid": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 4
            },
            "source_record": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "provenance": {
          "$ref": "#/$defs/asset"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0.0"
          }
        }
      },
      "then": {
        "properties": {
          "surfaces": {
            "items": {
              "properties": {
                "body": {
                  "enum": [
                    "moon",
                    "earth"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
